# Copy to .env.local and fill in the providers you actually use.
# .env.local is gitignored; never commit real keys.

# OpenCode Go (https://opencode.ai/zen/go/v1)
OPENCODE_GO_API_KEY=

# Command Code (https://api.commandcode.ai/provider/v1)
# Must go direct: long streams are reset when routed through a local proxy.
COMMAND_CODE_API_KEY=

# Optional: default provider name (opencode-go | commandcode)
# KEEL_PROVIDER=opencode-go

# Optional: path to a custom config file
# KEEL_CONFIG=~/.keel/config.json
